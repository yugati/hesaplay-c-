VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_h-HmMKmMJmwJUFHmItu81g_oTuDceXH

# Harita (opsiyonel): MapTiler Cloud anahtari uydu haritasi ve yer aramayi acar.
# Anahtari yalnizca kendi alan adlarinizda calisacak sekilde kisitlayin.
VITE_SAHA_MAPTILER_KEY=
# Istege bagli MapLibre uyumlu stil URL'si; seciciye "Ozel" harita katmani ekler.
VITE_SAHA_MAP_CUSTOM_STYLE_URL=

# --- Sunucu tarafi (Vercel serverless functions) - VITE_ ile BASLAMAZ, ---
# --- tarayiciya asla gonderilmez. Sadece Vercel proje ayarlarina eklenir. ---
# Supabase Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...)
# Vercel'deki otomatik Supabase entegrasyonuyla CAKISMAMASI icin SUPABASE_SERVICE_ROLE_KEY
# yerine bilerek farkli bir isim kullaniliyor - o entegrasyon farkli (yanlis) bir
# projeye bagliysa bu degeri sessizce ezebiliyordu.
APP_SUPABASE_SECRET_KEY=
# Oturum tokenlarini imzalamak icin rastgele, uzun bir gizli anahtar
SESSION_JWT_SECRET=

# --- Davetle kayit: e-posta gonderimi (CANLIDA ZORUNLU) ---
# Resend Dashboard -> API Keys. Davet kodu bu olmadan da uretilir (yonetici kodu
# elden iletir), AMA kayit olan kisinin e-postasina DOGRULAMA KODU bununla gider:
# tanimli degilse canlida kimse hesap acamaz (bkz. api/davet.js davetKabul).
# Yerelde (Vercel disi) kod sunucu konsoluna yazilir, akis e-postasiz denenebilir.
RESEND_API_KEY=
# Resend'de dogrulanmis bir gonderen adresi/alan adi (orn. "BYKARA <davet@bykara.org>").
# Bos birakilirsa Resend'in test alani (onboarding@resend.dev) kullanilir - o alan
# YALNIZCA Resend hesabinin kendi adresine gonderir; baskalarina dogrulama kodu
# gidebilmesi icin kendi alan adinizi Resend'de dogrulayip buraya yazin.
RESEND_FROM=
# Davet linklerinin kime gidecegi - kalici alan adiniz. Tanimli degilse istegin
# geldigi origin kullanilir (bkz. lib/invites.js davetLinki).
APP_BASE_URL=https://hesap.yugati.com.tr
