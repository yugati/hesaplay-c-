# --- Sunucu tarafi (Vercel serverless functions) - VITE_ ile BASLAMAZ, ---
# --- tarayiciya asla gonderilmez. Sadece Vercel proje ayarlarina eklenir. ---
# Supabase Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...)
# Vercel'deki otomatik Supabase entegrasyonuyla CAKISMAMASI icin SUPABASE_SERVICE_ROLE_KEY
# yerine bilerek farkli bir isim kullaniliyor - o entegrasyon farkli (yanlis) bir
# projeye bagliysa bu degeri sessizce ezebiliyordu.
APP_SUPABASE_SECRET_KEY=
# Oturum tokenlarini imzalamak icin rastgele, uzun bir gizli anahtar
SESSION_JWT_SECRET=

# --- Davetle kayit (opsiyonel) ---
# Resend Dashboard -> API Keys. Tanimli degilse davet eposta ile gonderilmez,
# admin linki elden kopyalayip iletir - davet sistemi yine calisir (bkz. lib/email.js).
RESEND_API_KEY=
# Resend'de dogrulanmis bir gonderen adresi/alan adi (orn. "BYKARA <davet@bykara.org>").
# Bos birakilirsa Resend'in test alani (onboarding@resend.dev) kullanilir.
RESEND_FROM=
# Davet linklerinin kime gidecegi - kalici alan adiniz. Tanimli degilse istegin
# geldigi origin kullanilir (bkz. lib/invites.js davetLinki).
APP_BASE_URL=https://hesap.yugati.com.tr
