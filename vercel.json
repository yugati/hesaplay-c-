{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/users/:id", "destination": "/api/users?id=:id" },
    { "source": "/api/invites/:id", "destination": "/api/invites?id=:id" },
    { "source": "/api/davet/:token/:action", "destination": "/api/davet?token=:token&action=:action" },
    { "source": "/api/davet/:token", "destination": "/api/davet?token=:token" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
